{
  "name": "mrbese-site",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "gates": "bash scripts/gates.sh --src && bash scripts/gates.sh --dist",
    "deploy": "bash scripts/gates.sh --src && astro build && bash scripts/gates.sh --dist && wrangler pages deploy dist --project-name=mrbese-site --branch=main --commit-hash=$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "astro": "^7.0.5",
    "typescript": "^6.0.3"
  }
}
