# Preserve CellSense, which is a separate GitHub Pages project served under the domain today.
# Its github.io project page stays live independently of this site, so 301 there.
# (Cutover note: alternatively host the CellSense build in public/cellsense/ to keep it first-party.)
/cellsense       https://mrbese.github.io/cellsense/          301
/cellsense/*     https://mrbese.github.io/cellsense/:splat    301

# Applying-in-public page retired (now committed to Shitster full-time, also
# in accelerator conversations). 301 both the bare page and any deep links.
/applying        /                                            301
/applying/*      /                                            301

# Services page removed. 301 the bare page and any deep links so old links
# and crawler caches do not land on a 404.
/services        /                                            301
/services/*      /                                            301

# Agents and validators probe the conventional path; Astro emits sitemap-index.xml.
/sitemap.xml     /sitemap-index.xml                           301
