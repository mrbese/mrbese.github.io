---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = posts.filter((p) => p.data.featured);
const rest = posts.filter((p) => !p.data.featured);
const fmt = (d: Date) =>
  `${String(d.getUTCMonth() + 1).padStart(2, '0')}.${String(d.getUTCFullYear() % 100).padStart(2, '0')}`;
---
<BaseLayout
  title="Writing · Omer Bese"
  description="Energy engineering, primary-source research, and productively frustrated observations."
  path="/writing"
>
  <div class="phead reveal">
    <div class="eyebrow">writing</div>
    <h1>Primary-source research, and the occasional raised eyebrow<span class="d">.</span></h1>
    <p class="sub">Sixty-plus hours per deep dive. All numbers cited. Nothing softened.</p>
  </div>

  {featured.length > 0 && (
    <section class="grp">
      <div class="lbl">research</div>
      {featured.map((p, i) => (
        <PostRow date={fmt(p.data.date)} title={p.data.title} href={`/writing/${p.id}/`} delay={i * 0.07} />
      ))}
    </section>
  )}

  {rest.length > 0 && (
    <section class="grp">
      <div class="lbl">notes</div>
      {rest.map((p, i) => (
        <PostRow date={fmt(p.data.date)} title={p.data.title} href={`/writing/${p.id}/`} delay={i * 0.07} />
      ))}
    </section>
  )}
</BaseLayout>
<style>
  .grp{margin-top:80px}
  .lbl{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3);margin-bottom:18px}
</style>
