---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services.ts';
import { social } from '../../data/social.ts';
const linkedin = social.find((s) => s.label === 'LinkedIn')?.href ?? '#';
---
<BaseLayout
  title="Services · Omer Bese"
  description="Things I will set up for you: agentic browser automation, smart home, credit-card points, and home energy audits."
  path="/services"
>
  <div class="phead reveal">
    <div class="eyebrow">services</div>
    <h1>A few things I will just set up for you<span class="d">.</span></h1>
    <p class="sub">Practical, hourly, no retainer. If it saves you a weekend of fighting with a manual, it paid for itself.</p>
  </div>

  <section class="list">
    {services.map((s) => (
      <article class="svc">
        <h2>{s.name}</h2>
        <p>{s.blurb}</p>
      </article>
    ))}
    <div class="cta">
      <a href={linkedin}>Ask me about it <span class="ar">&#8599;</span></a>
    </div>
  </section>
</BaseLayout>
<style>
  .list{margin-top:56px}
  .svc{margin-top:40px;max-width:64ch}
  .svc:first-child{margin-top:0}
  .svc h2{font-family:var(--display);font-style:italic;font-weight:400;font-size:var(--t-item);color:var(--ink-0)}
  .svc p{margin-top:10px;font-size:var(--t-note);line-height:1.6;color:var(--ink-1)}
  .cta{margin-top:48px}
  .cta::before{content:"";display:block;width:64px;height:1px;background:var(--ink-3);margin-bottom:26px}
  .cta a{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);transition:color var(--dur) var(--ease)}
  .cta a .ar{color:var(--ink-3);transition:color var(--dur) var(--ease)}
  .cta a:hover{color:var(--filament)}
  .cta a:hover .ar{color:var(--filament)}
</style>
