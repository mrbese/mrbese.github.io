---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import { education, career, fellowships } from '../data/timeline.ts';
import { site } from '../data/site.ts';
---
<BaseLayout
  title="About · Omer Bese"
  description="Energy systems engineer, founder, builder and operator. Columbia M.S., a decade across a family business, a nonprofit, and three startups."
  path="/about"
>
  <div class="phead reveal">
    <div class="eyebrow">about</div>
    <h1>the longer story<span class="d">.</span></h1>
  </div>

  <section class="essay">
    <div class="prose">
      <p>{site.lede}</p>
    </div>
    <div class="prose record">
      <p>
        Energy systems engineer who builds. I notice what doesn't work, trace it back to the
        assumption nobody questioned, and build the fix instead of complaining about it.
      </p>
      <p>
        Humankind walked on the moon before it invented the four-wheeled suitcase. That fact has
        always inspired and frustrated me at the same time. It inspires me because it shows the
        solution often already exists. It frustrates me because it shows how hard it is to break
        the status quo. We kept the vertical design instead of turning it horizontal, so now it
        tips over.
      </p>
      <p>
        I am equally baffled by pedal trash cans next to toilets, placed as if your foot could
        reach the lever right after wiping your ass. Or pull handles on push doors. Or faucet
        handles placed so the water in your hands drips outside the sink. Just a few entries on
        my list of crimes against humanity.
      </p>
    </div>
  </section>

  <Row label="education" num="01">
    {education.map((e) => (
      <div class="entry">
        <div class="etop"><span class="org">{e.org}</span><span class="per">{e.period}</span></div>
        <div class="role">{e.role}{e.location && <span class="loc"> · {e.location}</span>}</div>
        {e.note && <p class="note">{e.note}</p>}
      </div>
    ))}
  </Row>

  <Row label="work" num="02">
    {career.map((e) => (
      <div class="entry">
        <div class="etop"><span class="org">{e.org}</span><span class="per">{e.period}</span></div>
        <div class="role">{e.role}{e.location && <span class="loc"> · {e.location}</span>}</div>
        {e.note && <p class="note">{e.note}</p>}
      </div>
    ))}
  </Row>

  <Row label="elsewhere" num="03">
    <p class="fell">{fellowships.join('  ·  ')}</p>
  </Row>
</BaseLayout>
<style>
  .essay{display:grid;grid-template-columns:1fr;gap:40px;margin-top:48px}
  .essay .prose{max-width:var(--measure)}
  .record p{margin:0 0 1.3em}
  .record p:last-child{margin-bottom:0}
  .entry{margin-top:28px}
  .entry:first-child{margin-top:0}
  .etop{display:flex;justify-content:space-between;gap:16px;align-items:baseline}
  .org{font-family:var(--display);font-style:normal;font-weight:400;font-size:var(--t-item);color:var(--ink-0)}
  .per{font-family:var(--mono);font-size:11.5px;color:var(--ink-3);white-space:nowrap}
  .role{margin-top:3px;font-size:13px;color:var(--ink-2)}
  .role .loc{color:var(--ink-3)}
  .note{margin-top:10px;font-size:var(--t-body);line-height:1.6;color:var(--ink-1);max-width:66ch}
  .fell{font-size:14px;line-height:1.8;color:var(--ink-1)}
</style>
