---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { projects } from '../../data/projects.ts';
---
<BaseLayout
  title="Projects · Omer Bese"
  description="Live energy and consumer software, from national rebate-program design to insurance-policy investigation."
  path="/projects"
>
  <div class="phead reveal">
    <div class="eyebrow">projects</div>
    <h1>Projects I shipped<span class="d">.</span></h1>
    <p class="sub">Some out of annoyance, some out of interest, all out of curiosity.</p>
  </div>

  <section class="list">
    {projects.map((p) => <ProjectItem {...p} />)}
  </section>
</BaseLayout>
<style>
  .list{margin-top:56px}
</style>
