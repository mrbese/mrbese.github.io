---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { projects } from '../../data/projects.ts';
---
<BaseLayout
  title="Projects · Omer Bese"
  description="Energy tools: LiDAR home audits, battery ROI, and lithium HAZMAT shipping."
  path="/projects"
>
  <div class="phead reveal">
    <div class="eyebrow">projects</div>
    <h1>Energy tools I shipped<span class="d">.</span></h1>
    <p class="sub">Built to answer a question I actually had. Open source on GitHub where the code is ready.</p>
  </div>

  <section class="list">
    {projects.map((p) => <ProjectItem {...p} />)}
  </section>
</BaseLayout>
<style>
  .list{margin-top:56px}
</style>
