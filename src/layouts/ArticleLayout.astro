---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site.ts';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: string;
}
const { post, index = '01' } = Astro.props;
const { title, description, date, readTime, tags } = post.data;
const dateStr = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const posting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/writing/${post.id}/`, site.url).href,
};
---
<BaseLayout title={`${title} · Omer Bese`} description={description} ogType="article" path={`/writing/${post.id}/`}>
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author" content={site.url} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(posting)} />
  </Fragment>
  <article class="article">
    <a class="back" href="/writing">&larr; the writing</a>
    <div class="meta">
      <span class="idx">{index}</span>
      <span>{dateStr}</span>
      {readTime && <span>{readTime}</span>}
      {tags.map((t) => <span>{t}</span>)}
    </div>
    <h1>{title}</h1>
    <p class="standfirst">{description}</p>
    <div class="rule"></div>
    <div class="prose">
      <slot />
    </div>
  </article>
  <div class="afoot">
    <a href="/writing">all writing</a>
    <a href="/">home</a>
  </div>
</BaseLayout>
<style>
  .article{padding:56px 0 0}
  .back{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);transition:color var(--dur) var(--ease)}
  .back:hover{color:var(--filament)}
  .meta{margin-top:40px;display:flex;flex-wrap:wrap;gap:16px;font-family:var(--mono);font-size:var(--t-label);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3)}
  .meta .idx{color:var(--ink-2)}
  h1{margin-top:18px;font-family:var(--display);font-weight:400;font-size:var(--t-h1);line-height:1.12}
  .standfirst{margin-top:24px;font-size:var(--t-support);font-style:italic;line-height:1.6;color:var(--ink-2)}
  .rule{width:64px;height:1px;background:var(--ink-3);margin:40px 0}
  .afoot{margin-top:56px;padding-bottom:64px;display:flex;justify-content:space-between}
  .afoot a{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);transition:color var(--dur) var(--ease)}
  .afoot a:hover{color:var(--filament)}
</style>
