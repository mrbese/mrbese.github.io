---
import { social } from '../data/social.ts';
---
<footer class="colophon">
  <div class="rule reveal"></div>
  <nav class="clinks reveal" aria-label="Elsewhere">
    {social.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
  </nav>
  <p class="fine reveal">
    <span class="wm">omer bese<span class="d">.</span></span>
    <span class="c">&copy; 2026 &middot; built by asking &ldquo;why?&rdquo;</span>
  </p>
</footer>
<style>
  .colophon{margin-top:150px;padding:0 0 72px}
  .rule{width:64px;height:1px;background:var(--ink-3);margin-bottom:30px}
  .clinks{display:flex;gap:26px;margin-bottom:24px;flex-wrap:wrap}
  .clinks a{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);transition:color var(--dur) var(--ease)}
  .clinks a:hover{color:var(--filament)}
  .fine{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap}
  .wm{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2)}
  .wm .d{color:var(--filament)}
  .c{font-size:15px;font-style:italic;color:var(--ink-3)}
  @media(max-width:720px){.colophon{margin-top:96px}}
</style>
