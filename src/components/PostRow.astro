---
interface Props {
  date: string;
  title: string;
  href: string;
  delay?: number;
}
const { date, title, href, delay } = Astro.props;
---
<a class="post reveal" href={href} style={delay ? `--d:${delay}s` : undefined}>
  <span class="t">{title}</span>
  <span class="lead"></span>
  <span class="d">{date}</span>
</a>
<style>
  .post{display:flex;align-items:baseline;gap:12px;padding:11px 0;max-width:56ch}
  .t{font-family:var(--display);font-style:normal;font-size:var(--t-toc);color:var(--ink-0)}
  .lead{flex:1;border-bottom:1px dotted var(--ink-3);transform:translateY(-4px);transition:border-color var(--dur) var(--ease)}
  .d{font-family:var(--mono);font-size:11.5px;color:var(--ink-2);flex:none;font-variant-numeric:tabular-nums;transition:color var(--dur) var(--ease)}
  .post:hover .lead{border-color:var(--ink-2)}
  .post:hover .d{color:var(--filament)}
  @media(max-width:520px){.post{flex-wrap:wrap;gap:4px 12px}.lead{display:none}}
</style>
