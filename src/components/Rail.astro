---
import { site } from '../data/site.ts';
---
<div class="sigblock reveal">
  <div class="sig">
    <span class="dot"></span>{site.location}
  </div>
  <div class="focus">{site.focus}</div>
  <p class="now">{site.now}</p>
</div>
<style>
  .sigblock{margin-top:22px}
  .sig{display:inline-flex;align-items:center;font-family:var(--mono);font-size:var(--t-label);letter-spacing:.14em;color:var(--ink-2);text-transform:uppercase;transition:color var(--dur) var(--ease)}
  .sig:hover{color:var(--filament)}
  .dot{display:inline-block;width:6px;height:6px;border-radius:99px;background:var(--filament);margin-right:8px;flex:none}
  .focus{margin-top:10px;font-family:var(--mono);font-size:var(--t-label);letter-spacing:.14em;color:var(--ink-2);text-transform:uppercase}
  .now{margin-top:12px;font-size:var(--t-note);font-style:italic;line-height:1.65;color:var(--ink-2);max-width:44ch}
</style>
