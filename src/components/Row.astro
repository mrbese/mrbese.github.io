---
interface Props {
  label: string;
  num?: string;
  first?: boolean;
}
const { label, num, first } = Astro.props;
---
<section class:list={['sect', { first }]}>
  <h2 class="folio reveal">
    {num ? <Fragment><b>&#8470; {num}</b> &middot; {label}</Fragment> : label}
  </h2>
  <div class="b"><slot /></div>
</section>
<style>
  .sect{margin-top:128px}
  .folio{margin:0 0 18px;font-family:var(--mono);font-size:var(--t-label);font-weight:400;letter-spacing:.2em;color:var(--ink-3);text-transform:uppercase}
  .folio b{color:var(--ink-2);font-weight:400}
  .b{min-width:0}
  @media(max-width:720px){.sect{margin-top:80px}}
</style>
