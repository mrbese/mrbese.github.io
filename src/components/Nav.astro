---
const path = Astro.url.pathname;
const isHome = path === '/';
const items: [string, string][] = [
  ['/', 'home'],
  ['/about', 'about'],
  ['/writing', 'writing'],
  ['/projects', 'projects'],
  ['/services', 'services'],
  ['/retera', 'retera'],
  ['/shitster', 'shitster'],
];
const isOn = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<header class="mast">
  {isHome
    ? <span class="tagline">operator &middot; builder</span>
    : <a href="/" class="wm">omer bese<i>.</i></a>}
  <nav class="nav" aria-label="Primary">
    {items.map(([href, label]) => (
      <a href={href} class={isOn(href) ? 'on' : ''} aria-current={isOn(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
<style>
  .mast{display:flex;align-items:baseline;justify-content:space-between;gap:16px 24px;padding:26px 0 0;flex-wrap:wrap}
  .wm,.tagline{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2)}
  .wm{transition:color var(--dur) var(--ease)}
  .wm i{font-style:normal;color:var(--filament)}
  .wm:hover{color:var(--filament)}
  .nav{display:flex;align-items:baseline;gap:14px 24px;flex-wrap:wrap}
  .nav a{font-family:var(--mono);font-size:var(--t-label);letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);transition:color var(--dur) var(--ease)}
  .nav a.on{color:var(--ink-0)}
  .nav a:hover{color:var(--filament)}
  @media(max-width:600px){
    .mast{padding-top:20px}
    .nav{gap:12px 16px;width:100%}
  }
</style>
